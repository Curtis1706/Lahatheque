# ==============================================================================
# Variables d'Environnement — LAHAThèque Backend v3.2 (Production VPS Coolify)
# ==============================================================================

# --- Django Core ---
SECRET_KEY=votre_cle_secrete_longue_et_aleatoire_de_production
DEBUG=False
ALLOWED_HOSTS=api.lahatheque.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://lahatheque.com,https://app.lahatheque.com,https://api.lahatheque.com
CORS_ALLOWED_ORIGINS=https://lahatheque.com,https://app.lahatheque.com

# --- Database PostgreSQL (Neon ou PostgreSQL Local/Coolify) ---
# Format : postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgres://lahatheque_user:mot_de_passe_robuste@ep-sample-pooler.us-east-2.aws.neon.tech/lahatheque_db?sslmode=require

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- JWT Authentication ---
JWT_SECRET_KEY=cle_secrete_jwt_robuste

# --- SMTP Hostinger (E-mails Transactionnels) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=contact@lahacademia.com
EMAIL_HOST_PASSWORD=mot_de_passe_boite_mail_hostinger
DEFAULT_FROM_EMAIL=LAHATHEQUE <contact@lahacademia.com>

# --- FasterMessage SMS API (Relances Mobile & 2FA) ---
FASTERMESSAGE_API_KEY=votre_cle_api_fastermessage
FASTERMESSAGE_SENDER_ID=LAHAPAY

# --- Cloudflare R2 Storage (Couvertures, PDF sécurisés & Médias) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=votre_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=votre_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=lahatheque-media
CLOUDFLARE_R2_ENDPOINT=https://votre_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_DOMAIN=pub-98cb000b12874eae9d7deed8a2ead6ee.r2.dev

# --- Cloudflare Stream Audio ---
CLOUDFLARE_STREAM_ACCOUNT_ID=votre_stream_account_id
CLOUDFLARE_STREAM_API_TOKEN=votre_stream_api_token

# --- External LCP Server (EDRLab DRM) ---
LCP_SERVER_URL=https://lcp.lahatheque.com

# --- Paiements (Moneroo Mobile Money & Stripe) ---
MONEROO_API_KEY=app_pk_live_xxx
MONEROO_SECRET_KEY=app_sk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- SSO & OAuth2 Partenaires ---
SAML_IDP_METADATA_URL=https://idp.uac.bj/idp/shibboleth
